{
  "name": "capitoline",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted OpenAI-compatible gateway and MCP server over the official Claude Code, Codex and Antigravity CLIs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marco-fabbri/capitoline.git"
  },
  "homepage": "https://github.com/marco-fabbri/capitoline#readme",
  "bugs": {
    "url": "https://github.com/marco-fabbri/capitoline/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "keys": "node dist/keys-cli.js",
    "check-config": "node -e \"import('./dist/config.js').then(m => { m.loadConfig(process.env.CAPITOLINE_CONFIG ?? 'config/capitoline.yaml', process.env.CAPITOLINE_OVERLAY || undefined); console.log('configuration OK'); }).catch(e => { console.error(e.message); process.exit(1); })\"",
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "express": "^5.1.0",
    "jose": "^6.0.0",
    "pino": "^9.6.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
