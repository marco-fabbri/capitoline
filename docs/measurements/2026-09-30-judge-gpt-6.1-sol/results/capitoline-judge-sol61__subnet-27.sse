data: {"id":"chatcmpl-f7cab98f-3820-4b04-8af3-eaf1bce70841","object":"chat.completion.chunk","created":1790744800,"model":"capitoline-judge-sol61","choices":[{"index":0,"delta":{"content":"**Broadcast address:** `10.23.96.95`  \n**Usable host addresses:** **30**\n\nA `/27` leaves \\(32 - 27 = 5\\) host bits, giving \\(2^5 = 32\\) total addresses.\n\n- Broadcast: \\(64 + 32 - 1 = 95\\), so `10.23.96.95`.\n- Usable hosts: \\(32 - 2 = 30\\), excluding the network and broadcast addresses.\n\nThe usable range is `10.23.96.65`–`10.23.96.94`."},"finish_reason":null}]}

